# Environment settings template
PROJECT_NAME="Auto Apply AI"
API_V1_STR="/api/v1"

# Database Configurations
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_development_secure_pass"
POSTGRES_DB="auto_apply_db"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:password@localhost:5432/auto_apply_db"

# Redis Configurations
REDIS_HOST="localhost"
REDIS_PORT=6379

# Deployment & CORS Setup
CORS_ORIGINS="https://your-frontend-domain.com"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/v1/auth/gmail/callback"
NEXT_PUBLIC_API_BASE="https://your-domain.com"

# Firebase Setup
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_STORAGE_BUCKET="your-firebase-storage-bucket.appspot.com"

# Security Setup
SECRET_KEY="replace_this_with_a_properly_generated_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI & Gemini API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

