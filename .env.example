# Database
POSTGRES_PASSWORD=your_secure_db_password

# Security
SECRET_KEY=your_secure_jwt_secret_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
